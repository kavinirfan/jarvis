{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "eval": "node --conditions=react-server --import tsx scripts/eval.ts",
    "check:wakeword": "tsx scripts/check-wakeword.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "postinstall": "node scripts/copy-ort.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run check:secrets"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "onnxruntime-web": "1.30.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "onnxruntime-node": "1.30.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs": false
  }
}
