# JARVIS configuration. Copy to .env.local (never commit .env.local) and fill in what you have.
# Everything is optional except GEMINI_API_KEY for real AI answers; without it JARVIS runs in a
# clearly-labelled mock mode.

# --- AI (Google Gemini) -------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Force mock providers even when keys exist (for demos/tests): JARVIS_PROVIDER_MODE=mock

# --- Web search (research) ----------------------------------------------------------------
# auto = first configured of: tavily → brave → gemini (if enabled) → wikipedia (keyless)
# SEARCH_PROVIDER=auto
# Tavily (https://tavily.com, free tier available)
TAVILY_API_KEY=
# Brave Search API (https://api.search.brave.com)
BRAVE_SEARCH_API_KEY=
# Google Search grounding through Gemini (needs a Gemini plan that includes grounding)
# GEMINI_SEARCH_GROUNDING=true
# Optional contact info appended to JARVIS's User-Agent for sites/APIs (e.g. a URL)
# JARVIS_CONTACT=

# --- Database -----------------------------------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) stored in .data/pglite.
# For production use a PostgreSQL server, e.g. postgres://user:pass@host:5432/jarvis
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# --- Accounts & limits --------------------------------------------------------------------
# Only the first account can sign up unless this is true.
# JARVIS_ALLOW_REGISTRATION=false
# Extra admins allowed to change prompt configurations (comma-separated)
# JARVIS_ADMIN_EMAILS=
# Per-user daily budget of AI/search/voice requests (default 400)
# JARVIS_DAILY_REQUEST_BUDGET=400
